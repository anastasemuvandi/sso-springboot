            "type" : "integer",
            "format" : "int64"
          },
          "app_id" : {
            "type" : "string"
          }
        }
      },
      "AuditEventCreate" : {
        "type" : "object",
        "properties" : {
          "app_id" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "details" : {
            "type" : "object",
            "additionalProperties" : { },
            "description" : "Free-form JSON object (wrapper convention: details.outcome carries success/failure/denied)"
          },
          "employee_id" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "event_type" : {
            "type" : "string",
            "description" : "Dotted event type; the prefix decides the category (auth., authz., admin., lifecycle., session., cert.; anything else is UNKNOWN)",
            "example" : "auth.login.success",
            "maxLength" : 100,
            "minLength" : 0
          },
          "institution" : {
            "type" : "string",
            "description" : "Institution slug (ADR-0001)",
            "maxLength" : 100,
            "minLength" : 0
          },
          "ip_address" : {
            "type" : "string",
            "maxLength" : 45,
            "minLength" : 0
          },
          "performed_by" : {
            "type" : "string",
            "description" : "The actor",
            "maxLength" : 255,
            "minLength" : 0
          },
          "realm" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "severity" : {
            "type" : "string",
            "default" : "INFO",
            "enum" : [ "INFO", "WARNING", "CRITICAL" ]
          },
          "target" : {
            "type" : "string",
            "description" : "What was acted on: user id, client id or role name",
            "maxLength" : 255,
            "minLength" : 0
          },
          "user_id" : {
            "type" : "string",
            "maxLength" : 255,
            "minLength" : 0
          }
        },
        "required" : [ "event_type" ]
      },
      "AuditEventRead" : {
        "type" : "object",
        "properties" : {
          "app_id" : {
            "type" : "string"
          },
          "category" : {
            "type" : "string"
          },
          "created_at" : {
            "type" : "string",
            "format" : "date-time"
          },
          "details" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "employee_id" : {
            "type" : "string"
          },
          "event_hash" : {
            "type" : "string"
          },
          "event_type" : {
            "type" : "string"
          },
          "hash_version" : {
            "type" : "integer",
            "format" : "int32"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "institution" : {
            "type" : "string"
          },
          "ip_address" : {
            "type" : "string"
          },
          "performed_by" : {
            "type" : "string"
          },
          "prev_hash" : {
            "type" : "string"
          },
          "realm" : {
            "type" : "string"
          },
          "severity" : {
            "type" : "string"
          },
          "target" : {
            "type" : "string"
          },
          "user_id" : {
            "type" : "string"
          }
        }
      },
      "CertExpiryItem" : {
        "type" : "object",
        "properties" : {
          "cert_expiry" : {
            "type" : "string",
