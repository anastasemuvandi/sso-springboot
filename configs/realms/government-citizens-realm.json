{
  "realm": "government-citizens",
  "displayName": "Government Services - Citizens Portal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "rw"
  ],
  "defaultLocale": "en",
  "loginTheme": "government-citizens",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "INTROSPECT_TOKEN",
    "INTROSPECT_TOKEN_ERROR",
    "USER_INFO_REQUEST",
    "USER_INFO_REQUEST_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "webAuthnPolicyRpEntityName": "GoR Citizens",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "clients": [
    {
      "clientId": "citizens-portal",
      "name": "Citizens Portal Application",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "test_citizen",
      "email": "citizen@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Citizen",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "Citizen#Dev2026",
          "temporary": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "citizen",
        "description": "Basic citizen role"
      }
    ]
  },
  "defaultRoles": [
    "citizen"
  ],
  "passwordPolicy": "length(10) and upperCase(1) and lowerCase(1) and digits(1)",
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 0,
  "maxDeltaTimeSeconds": 43200
}
