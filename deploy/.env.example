# =============================================================================
# GoRSSO compose environment. Copy to deploy/.env and pass it explicitly:
#   docker compose -p gorsso --env-file deploy/.env -f deploy/docker-compose.base.yml ...
# (the Makefile does this when deploy/.env exists).
#
# DEV: every variable is optional; the compose files carry dev defaults.
# STAGING / PROD: every secret below is REQUIRED (the overlays use ${VAR:?}). Generate with
#   openssl rand -base64 36
# Prefer Docker secrets (<NAME>_FILE) for the services that support them: the wrapper, audit,
# BFF, IPPIS mock, Postgres init and the seeder read <NAME>_FILE for each secret they take.
# NEVER commit deploy/.env.
# =============================================================================

# ---- Images ----------------------------------------------------------------
REGISTRY=gorsso
TAG=dev

# ---- Host ports (dev defaults = the reference stack's) ----------------------
# Change these to run a second stack next to another one.
HOST_PORT_KEYCLOAK=8080
HOST_PORT_WRAPPER=8000
HOST_PORT_CONSOLE=3001
HOST_PORT_AUDIT=8001
HOST_PORT_NOTIFICATION=8002
HOST_PORT_IPPIS=8003
HOST_PORT_POSTGRES=5435
HOST_PORT_REDIS=6380
HOST_PORT_MAILHOG=8025
HOST_PORT_ADMINER=8081
# Interface Postgres, Redis and Adminer are published on (dev: loopback only).
HOST_BIND=127.0.0.1

# ---- Browser-facing URLs (dev defaults: http://localhost:<port>) ------------
# PUBLIC_KEYCLOAK_URL is Keycloak's KC_HOSTNAME and the wrapper's issuer; it MUST be the URL
# browsers use, scheme and port included.
# PUBLIC_KEYCLOAK_URL=http://localhost:8080
# PUBLIC_WRAPPER_URL=http://localhost:8000
# PUBLIC_CONSOLE_URL=http://localhost:3001
# Extra console origins registered on sso-admin-ui by the seeder (comma-separated).
# CONSOLE_PUBLIC_URLS=http://localhost:3001,http://localhost:5173
# WRAPPER_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8000,http://localhost:5173,http://localhost:5174

# ---- Postgres (one database + role per service; deploy/postgres/initdb) -----
POSTGRES_USER=gorsso
POSTGRES_PASSWORD=
KC_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
AUDIT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# ---- Keycloak ---------------------------------------------------------------
# Bootstrap admin: created on a FRESH database only; rotate after first login.
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=
# KC_MEM_LIMIT=1500m
# KC_JAVA_OPTS_KC_HEAP=-XX:MaxRAMPercentage=70 -XX:MinRAMPercentage=70 -XX:InitialRAMPercentage=25
# Prod: the compose network that may set X-Forwarded-* (https-portal).
# KC_PROXY_TRUSTED_ADDRESSES=172.16.0.0/12

# ---- Shared secrets -----------------------------------------------------------
# SSO_CLIENT_SECRET / ADMIN_UI_CLIENT_SECRET must equal the secrets of the `sso-client` /
# `sso-admin-ui` clients in Keycloak (the seeder sets them to these values).
SSO_CLIENT_SECRET=
ADMIN_UI_CLIENT_SECRET=
AUDIT_API_KEY=
IPPIS_API_KEY=
IPPIS_WEBHOOK_SECRET=
NOTIFICATION_API_KEY=
WRAPPER_SECRET_KEY=
ACCESS_MATRIX_SIGNING_KEY=

# ---- Seeder (dev) -------------------------------------------------------------
# SEED_INSTITUTIONS=minagri,minisante
# SEED_DEMO_PASSWORD=GorSsoDev#2026
# Public PKCE clients for sample-apps/web (<clientId>=<origin>, comma-separated; none = skip).
# SEED_SAMPLE_SPAS=minagri-kubaka-spa=http://localhost:5173,minisante-hmis-spa=http://localhost:5174

# ---- Mail (staging/prod; dev uses MailHog) -----------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=sso-noreply@gov.rw
# ADMIN_EMAILS=security@gov.rw

# ---- IPPIS ----------------------------------------------------------------------
# Real IPPIS (staging may still use the mock; prod requires this).
# IPPIS_SERVER_URL=https://ippis.example.gov.rw

# ---- Staging (docker-compose.staging.yml) --------------------------------------
# The address browsers reach the staging box on.
# STAGING_HOST=10.10.73.8

# ---- Production (docker-compose.prod.yml) ---------------------------------------
# All three must resolve publicly for the Let's Encrypt challenge.
# PROD_DOMAIN_SSO=sso.gov.rw
# PROD_DOMAIN_ADMIN=admin.sso.gov.rw
# PROD_DOMAIN_KEYCLOAK=keycloak.sso.gov.rw
