# Environment for running the wrapper jar as an ops CLI on the HOST against the dev compose stack
# (published ports). Dev values only.
#   set -a; source deploy/dev-cli.env; set +a
#   java -jar sso-wrapper/target/sso-wrapper-*.jar delegated-check
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_LOCAL_ISSUER=http://localhost:8080
KEYCLOAK_REALM=government-internal
KEYCLOAK_CLIENT_ID=sso-client
KEYCLOAK_CLIENT_SECRET=gorsso-dev-sso-client
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
REDIS_HOST=localhost
REDIS_PORT=6380
AUDIT_SERVICE_URL=http://localhost:8001
AUDIT_API_KEY=gorsso-dev-audit-key
IPPIS_BASE_URL=http://localhost:8003
IPPIS_API_KEY=gorsso-dev-ippis-key
IDENTITY_DATABASE_URL=jdbc:postgresql://localhost:5435/sso_identity
IDENTITY_DATABASE_USER=sso_identity_rw
IDENTITY_DATABASE_PASSWORD=sso-identity-dev
SECRET_KEY=gorsso-dev-wrapper-secret-key-not-for-production-000000
ACCESS_MATRIX_SIGNING_KEY=gorsso-dev-access-matrix-signing-key-0000
