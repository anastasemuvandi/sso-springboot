# Shared key the SSO must send as X-IPPIS-API-Key (must match the wrapper's IPPIS_API_KEY).
IPPIS_API_KEY=change-me-in-ippis
# Optional: persist the store across restarts.
# IPPIS_MOCK_DATA_FILE=/ippis/data/employees.json
# Optional push emission to the wrapper (both required):
# SSO_EVENTS_URL=http://sso-wrapper:8000/ippis/events
# IPPIS_WEBHOOK_SECRET=change-me
# IPPIS_MOCK_SIGNATURE_MODE=timestamped
