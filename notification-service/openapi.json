        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AlertRead"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "NotificationApiKey" : [ ]
        } ],
        "summary" : "Acknowledge an alert (re-arms its rule's cooldown for that subject)",
        "tags" : [ "alerts" ]
      }
    },
    "/config" : {
      "get" : {
        "operationId" : "list_1",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
