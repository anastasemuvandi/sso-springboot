{
  "components" : {
    "schemas" : {
      "AcknowledgeRequest" : {
        "properties" : {
          "acknowledged_by" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "acknowledged_by" ],
        "type" : "object"
      },
      "AlertConfigRead" : {
        "properties" : {
          "channels" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "cooldown_minutes" : {
            "format" : "int32",
            "type" : "integer"
          },
          "enabled" : {
            "type" : "boolean"
          },
          "id" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "rule_name" : {
            "type" : "string"
          },
          "severity" : {
            "type" : "string"
          },
          "threshold" : {
            "format" : "int32",
            "type" : "integer"
          },
          "updated_at" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "window_minutes" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "AlertConfigUpdate" : {
        "properties" : {
          "channels" : {
            "description" : "Subset of email, inapp, webhook",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "cooldown_minutes" : {
            "format" : "int32",
            "type" : "integer"
          },
          "enabled" : {
            "type" : "boolean"
          },
          "severity" : {
            "enum" : [ "CRITICAL", "WARNING", "INFO" ],
            "type" : "string"
          },
          "threshold" : {
            "format" : "int32",
            "type" : "integer"
          },
          "window_minutes" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "AlertRead" : {
        "properties" : {
          "acknowledged" : {
            "type" : "boolean"
          },
          "acknowledged_at" : {
            "format" : "date-time",
            "type" : "string"
          },
          "acknowledged_by" : {
            "type" : "string"
          },
          "app_id" : {
            "type" : "string"
          },
          "created_at" : {
            "format" : "date-time",
            "type" : "string"
          },
          "details" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "ip_address" : {
            "type" : "string"
          },
          "rule_name" : {
            "type" : "string"
          },
          "severity" : {
            "type" : "string"
          },
          "user_id" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "DailyReport" : {
        "properties" : {
          "acknowledged" : {
            "format" : "int32",
            "type" : "integer"
          },
          "by_rule" : {
            "additionalProperties" : {
              "format" : "int32",
              "type" : "integer"
            },
            "type" : "object"
          },
          "critical" : {
            "format" : "int32",
            "type" : "integer"
          },
          "latest" : {
            "items" : {
              "$ref" : "#/components/schemas/AlertRead"
            },
            "type" : "array"
          },
          "period_end" : {
            "format" : "date-time",
            "type" : "string"
          },
          "period_start" : {
            "format" : "date-time",
            "type" : "string"
          },
          "total" : {
            "format" : "int32",
            "type" : "integer"
          },
          "warning" : {
            "format" : "int32",
            "type" : "integer"
          }
