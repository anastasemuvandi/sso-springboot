          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AlertRead"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "NotificationApiKey" : [ ]
        } ],
