          "description" : "Filter by CRITICAL/WARNING/INFO",
          "in" : "query",
          "name" : "severity",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Filter by acknowledged status",
          "in" : "query",
          "name" : "acknowledged",
          "required" : false,
          "schema" : {
            "type" : "boolean"
          }
        }, {
          "in" : "query",
          "name" : "rule_name",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 100,
            "format" : "int32",
            "maximum" : 500,
            "minimum" : 1,
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "offset",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/AlertRead"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "NotificationApiKey" : [ ]
        } ],
        "summary" : "List alerts, newest first",
        "tags" : [ "alerts" ]
      }
    },
    "/alerts/{alert_id}" : {
      "get" : {
        "operationId" : "get",
        "parameters" : [ {
          "in" : "path",
          "name" : "alert_id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
