            "format" : "uuid",
            "type" : "string"
          },
          "channel" : {
            "enum" : [ "email", "inapp", "webhook" ],
            "type" : "string"
          },
          "created_at" : {
            "format" : "date-time",
            "type" : "string"
          },
          "error" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "is_read" : {
            "type" : "boolean"
          },
          "message" : {
            "type" : "string"
          },
          "recipient" : {
            "type" : "string"
          },
          "sent_at" : {
            "format" : "date-time",
            "type" : "string"
          },
          "status" : {
            "enum" : [ "pending", "sent", "failed", "skipped" ],
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
