# Ministry of Agriculture — dev public PKCE client `minagri-kubaka-spa` (created by tools/seeder; the confidential `minagri-kubaka-web` is for server-side apps).
# Public PKCE client: no secret here, ever.
VITE_INSTITUTION=minagri
VITE_INSTITUTION_NAME=Ministry of Agriculture and Animal Resources
VITE_APP_NAME=Kubaka
VITE_GORSSO_BASE_URL=http://localhost:8000
VITE_CLIENT_ID=minagri-kubaka-spa
# Must be registered on the client EXACTLY (dev tfvars allow http://localhost:*/*).
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_SCOPES=openid profile email
# "" = same origin (/api is proxied by Vite in dev and by nginx in the container)
VITE_API_BASE=
VITE_DEV_PORT=5173
API_PROXY_TARGET=http://localhost:8081
