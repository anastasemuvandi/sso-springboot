{
  "name": "gorsso-sample-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode minagri",
    "dev:minagri": "vite --mode minagri",
    "dev:minisante": "vite --mode minisante",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --mode minagri && vite build --mode minisante",
    "build:minagri": "vite build --mode minagri",
    "build:minisante": "vite build --mode minisante",
    "preview": "vite preview --mode minagri",
    "test": "vitest run"
  },
  "dependencies": {
    "@gorsso/react": "file:../../sdk/react",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.18.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
